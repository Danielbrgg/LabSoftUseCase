<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AppTask</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/AppTask.styles.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar">

            <div class="container-fluid">

                <!-- LOGO -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    AppTask
                </a>


                <!-- MENU -->

                <div class="navbar-collapse">

                    <ul class="navbar-nav">


                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <!-- TAREFA -->

                        <li class="nav-item">

                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tarefa" ? "active" : "")"
                               asp-area=""
                               asp-controller="Tarefa"
                               asp-action="Index">

                                Tarefa

                            </a>

                        </li>


                        <!-- FUNCIONÁRIO -->

                        <li class="nav-item">

                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Funcionario" ? "active" : "")"
                               asp-area=""
                               asp-controller="Funcionario"
                               asp-action="Index">

                                Funcionário

                            </a>

                        </li>


                        <!-- DEPARTAMENTO -->

                        <li class="nav-item">

                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departamento" ? "active" : "")"
                               asp-area=""
                               asp-controller="Departamento"
                               asp-action="Index">

                                Departamento

                            </a>

                        </li>


                        <!-- INCIDENTE -->

                        <li class="nav-item">

                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Incidente" ? "active" : "")"
                               asp-area=""
                               asp-controller="Incidente"
                               asp-action="Index">

                                Incidente

                            </a>

                        </li>


                        <!-- CENTRAL DE CUSTOS -->

                        <li class="nav-item">

                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CentralDeCustos" ? "active" : "")"
                               asp-area=""
                               asp-controller="CentralDeCustos"
                               asp-action="Index">

                                Central De Custos

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- CONTEÚDO DA PÁGINA -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- FOOTER -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - AppTask -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>