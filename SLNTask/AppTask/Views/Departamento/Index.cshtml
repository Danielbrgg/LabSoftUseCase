@model IEnumerable<AppTask.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Departamentos</h1>
        <p class="text-secondary mb-0">Gerencie os departamentos da organização.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Novo departamento</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Descrição</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Descricao</td>
                        <td>
                            @if (item.Ativo == true)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else if (item.Ativo == false)
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Não informado</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
