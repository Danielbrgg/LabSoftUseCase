@model AppTask.Models.Departamento

@{ ViewData["Title"] = "Editar departamento"; }
<div class="mb-4"><h1 class="fw-bold">Editar departamento</h1><p class="text-secondary">Atualize os dados do departamento.</p></div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
<form asp-action="Edit" method="post">
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Codigo" />
<div class="mb-3"><label asp-for="Descricao" class="form-label fw-semibold">Descrição</label><input asp-for="Descricao" class="form-control" /><span asp-validation-for="Descricao" class="text-danger"></span></div>
<div class="form-check mb-4"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">Departamento ativo</label></div>
<button type="submit" class="btn btn-primary">Salvar alterações</button><a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
</form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
