@model AppTask.Models.Departamento

@{ ViewData["Title"] = "Detalhes do departamento"; }
<div class="mb-4"><h1 class="fw-bold">Detalhes do departamento</h1><p class="text-secondary">Informações cadastradas.</p></div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
<dl class="row mb-4"><dt class="col-sm-4 text-secondary">Código</dt><dd class="col-sm-8">@Model.Codigo</dd><dt class="col-sm-4 text-secondary">Descrição</dt><dd class="col-sm-8 fw-semibold">@Model.Descricao</dd><dt class="col-sm-4 text-secondary">Status</dt><dd class="col-sm-8">@(Model.Ativo == true ? "Ativo" : Model.Ativo == false ? "Inativo" : "Não informado")</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Codigo" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary ms-2">Voltar</a>
</div></div>
