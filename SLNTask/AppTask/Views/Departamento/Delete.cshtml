@model AppTask.Models.Departamento

@{ ViewData["Title"] = "Excluir departamento"; }
<div class="mb-4"><h1 class="fw-bold text-danger">Excluir departamento</h1><p class="text-secondary">Esta ação não poderá ser desfeita.</p></div>
<div class="card shadow-sm border-0 border-start border-danger border-4"><div class="card-body p-4">
<p>Tem certeza de que deseja excluir este departamento?</p><h2 class="h5 fw-bold">@Model.Descricao</h2><p class="text-secondary mb-4">Código: @Model.Codigo</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Codigo" /><button type="submit" class="btn btn-danger">Sim, excluir</button><a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a></form>
</div></div>
