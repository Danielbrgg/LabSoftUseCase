@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Editar central de custo";
}

<div class="mb-4">
    <h1 class="fw-bold">Editar central de custo</h1>
    <p class="text-secondary">Atualize os dados da central selecionada.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Codigo" />

            <div class="mb-3">
                <label asp-for="NomeCentral" class="form-label fw-semibold">Nome da central</label>
                <input asp-for="NomeCentral" class="form-control" />
                <span asp-validation-for="NomeCentral" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ValorMetaAnual" class="form-label fw-semibold">Meta anual</label>
                <input asp-for="ValorMetaAnual" type="number" step="1" min="0" class="form-control" />
                <span asp-validation-for="ValorMetaAnual" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
