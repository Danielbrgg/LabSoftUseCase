@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Detalhes da central";
}

<div class="mb-4">
    <h1 class="fw-bold">Detalhes da central</h1>
    <p class="text-secondary">Confira as informações cadastradas.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <dl class="row mb-4">
            <dt class="col-sm-4 text-secondary">Código</dt>
            <dd class="col-sm-8">@Model.Codigo</dd>
            <dt class="col-sm-4 text-secondary">Nome da central</dt>
            <dd class="col-sm-8 fw-semibold">@Model.NomeCentral</dd>
            <dt class="col-sm-4 text-secondary">Meta anual</dt>
            <dd class="col-sm-8">@(Model.ValorMetaAnual.HasValue ? Model.ValorMetaAnual.Value.ToString("C2", new System.Globalization.CultureInfo("pt-BR")) : "Não definida")</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.Codigo" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Voltar</a>
    </div>
</div>
