@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Editar funcionário";
}

<div class="mb-4">
    <h1 class="fw-bold">Editar funcionário</h1>
    <p class="text-secondary">Atualize os dados do funcionário.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Codigo" />

            <div class="mb-3">
                <label asp-for="Nome" class="form-label fw-semibold">
                    Nome
                </label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Nome do funcionário" />

                <span asp-validation-for="Nome"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cargo" class="form-label fw-semibold">
                    Cargo
                </label>

                <input asp-for="Cargo"
                       class="form-control"
                       placeholder="Cargo do funcionário" />

                <span asp-validation-for="Cargo"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="IdGerente" class="form-label fw-semibold">
                    Gerente
                </label>

                <select asp-for="IdGerente"
                        class="form-select"
                        asp-items="ViewBag.IdGerente">
                    <option value="">-- Nenhum gerente --</option>
                </select>

                <span asp-validation-for="IdGerente"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Salvar alterações
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                Cancelar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}