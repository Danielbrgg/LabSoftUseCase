@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Excluir funcionário";
}

<div class="mb-4">
    <h1 class="fw-bold">Excluir funcionário</h1>
    <p class="text-secondary">
        Confira os dados antes de excluir este funcionário.
    </p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <div class="alert alert-warning">
            Tem certeza que deseja excluir este funcionário?
        </div>

        <dl class="row mb-4">

            <dt class="col-sm-3">
                Código
            </dt>

            <dd class="col-sm-9">
                @Model.Codigo
            </dd>

            <dt class="col-sm-3">
                Nome
            </dt>

            <dd class="col-sm-9">
                @Model.Nome
            </dd>

            <dt class="col-sm-3">
                Cargo
            </dt>

            <dd class="col-sm-9">
                @Model.Cargo
            </dd>

            <dt class="col-sm-3">
                Gerente
            </dt>

            <dd class="col-sm-9">
                @if (Model.Gerente != null)
                {
                    @Model.Gerente.Nome
                }
                else
                {
                    <span class="text-secondary">
                        Nenhum gerente
                    </span>
                }
            </dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Codigo" />

            <button type="submit" class="btn btn-danger">
                Excluir
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                Cancelar
            </a>

        </form>

    </div>
</div>