@model AppTask.Models.Tarefa

@{ ViewData["Title"] = "Nova tarefa"; }
<div class="mb-4"><h1 class="fw-bold">Nova tarefa</h1><p class="text-secondary">Cadastre uma tarefa e defina seu responsável e datas.</p></div>
<div class="card shadow-sm border-0"><div class="card-body p-4"><form asp-action="Create" method="post">
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="mb-3"><label asp-for="Descricao" class="form-label fw-semibold">Descrição</label><input asp-for="Descricao" class="form-control" placeholder="Descreva a tarefa" /><span asp-validation-for="Descricao" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DataPlanejada" class="form-label fw-semibold">Data planejada</label><input asp-for="DataPlanejada" type="datetime-local" class="form-control" /><span asp-validation-for="DataPlanejada" class="text-danger"></span></div>
<div class="row g-3">
<div class="col-md-4"><label asp-for="DataIniciada" class="form-label fw-semibold">Data iniciada</label><input asp-for="DataIniciada" type="datetime-local" class="form-control" /><span asp-validation-for="DataIniciada" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="DataFinalizada" class="form-label fw-semibold">Data finalizada</label><input asp-for="DataFinalizada" type="datetime-local" class="form-control" /><span asp-validation-for="DataFinalizada" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="DataCancelada" class="form-label fw-semibold">Data cancelada</label><input asp-for="DataCancelada" type="datetime-local" class="form-control" /><span asp-validation-for="DataCancelada" class="text-danger"></span></div>
</div>
<div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="StatusTarefa" class="form-label fw-semibold">Status</label><input asp-for="StatusTarefa" class="form-control" placeholder="Ex.: Pendente" /><span asp-validation-for="StatusTarefa" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Prazo" class="form-label fw-semibold">Prazo</label><input asp-for="Prazo" class="form-control" placeholder="Ex.: 5 dias" /><span asp-validation-for="Prazo" class="text-danger"></span></div></div>
<div class="mt-3 mb-4"><label asp-for="FuncionarioId" class="form-label fw-semibold">Responsável</label><select asp-for="FuncionarioId" class="form-select" asp-items="ViewBag.FuncionarioId"><option value="">-- Selecione um funcionário --</option></select><span asp-validation-for="FuncionarioId" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Cadastrar tarefa</button><a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
</form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
