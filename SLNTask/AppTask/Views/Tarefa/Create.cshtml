@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Criar Tarefa";
}

<h1>Criar Tarefa</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataPlanejada" class="control-label"></label>
                <input asp-for="DataPlanejada"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="DataPlanejada"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataIniciada" class="control-label"></label>
                <input asp-for="DataIniciada"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="DataIniciada"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataFinalizada" class="control-label"></label>
                <input asp-for="DataFinalizada"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="DataFinalizada"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataCancelada" class="control-label"></label>
                <input asp-for="DataCancelada"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="DataCancelada"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StatusTarefa" class="control-label"></label>
                <input asp-for="StatusTarefa" class="form-control" />
                <span asp-validation-for="StatusTarefa"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Prazo" class="control-label"></label>
                <input asp-for="Prazo" class="form-control" />
                <span asp-validation-for="Prazo"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FuncionarioId" class="control-label">
                    Responsável
                </label>

                <select asp-for="FuncionarioId"
                        class="form-control"
                        asp-items="ViewBag.FuncionarioId">
                    <option value="">-- Selecione um funcionário --</option>
                </select>

                <span asp-validation-for="FuncionarioId"
                      class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Criar Tarefa"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<br />

<div>
    <a asp-action="Index">Voltar para lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}