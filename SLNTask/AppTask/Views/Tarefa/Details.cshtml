@model AppTask.Models.Tarefa

@{ ViewData["Title"] = "Detalhes da tarefa"; }
<div class="mb-4"><h1 class="fw-bold">Detalhes da tarefa</h1><p class="text-secondary">Confira todas as informações da tarefa.</p></div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
<dl class="row mb-4"><dt class="col-sm-4 text-secondary">Código</dt><dd class="col-sm-8">@Model.Codigo</dd><dt class="col-sm-4 text-secondary">Descrição</dt><dd class="col-sm-8 fw-semibold">@Model.Descricao</dd><dt class="col-sm-4 text-secondary">Data planejada</dt><dd class="col-sm-8">@Model.DataPlanejada.ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-4 text-secondary">Data iniciada</dt><dd class="col-sm-8">@(Model.DataIniciada?.ToString("dd/MM/yyyy HH:mm") ?? "Não informada")</dd><dt class="col-sm-4 text-secondary">Data finalizada</dt><dd class="col-sm-8">@(Model.DataFinalizada?.ToString("dd/MM/yyyy HH:mm") ?? "Não informada")</dd><dt class="col-sm-4 text-secondary">Data cancelada</dt><dd class="col-sm-8">@(Model.DataCancelada?.ToString("dd/MM/yyyy HH:mm") ?? "Não informada")</dd><dt class="col-sm-4 text-secondary">Status</dt><dd class="col-sm-8"><span class="badge bg-primary">@Model.StatusTarefa</span></dd><dt class="col-sm-4 text-secondary">Prazo</dt><dd class="col-sm-8">@Model.Prazo</dd><dt class="col-sm-4 text-secondary">Responsável</dt><dd class="col-sm-8">@(Model.Funcionario?.Nome ?? "Não informado")</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Codigo" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary ms-2">Voltar</a>
</div></div>
